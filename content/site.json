          "kind": "page",
          "pageId": "work"
        },
        "showOn": "both",
        "hover": "tint"
      },
      {
        "id": "nav-diary",
        "type": "page",
        "target": {
          "kind": "page",
          "pageId": "diary"
        },
        "showOn": "both",
        "hover": "tint"
      },
      {
        "id": "nav-playlists",
