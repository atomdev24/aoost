{
  "name": "aoost-cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/link-dev-vars.mjs",
    "dev": "npm run build && wrangler dev",
    "dev:admin": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs && tsx scripts/build-site.ts",
    "build:site": "tsx scripts/build-site.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "deploy:preview": "npm run playlists:refresh && npm run build && wrangler deploy",
    "playlists:refresh": "tsx scripts/refresh-playlists.ts"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@puckeditor/core": "^0.24.0",
    "lottie-web": "^5.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
